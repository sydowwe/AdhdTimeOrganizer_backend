<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>14</LangVersion>
        <RootNamespace>AdhdTimeOrganizer.Planning</RootNamespace>
    </PropertyGroup>

    <!-- Same shape as AdhdTimeOrganizer.Core / .TodoLists / .History / .Routines: a plain library
         (Microsoft.NET.Sdk) that holds endpoints, so it needs the ASP.NET Core surface, and the Web
         SDK's implicit usings are not in scope here and are re-declared below. -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.AspNetCore.Builder"/>
        <Using Include="Microsoft.AspNetCore.Http"/>
        <Using Include="Microsoft.Extensions.Configuration"/>
        <Using Include="Microsoft.Extensions.DependencyInjection"/>
        <Using Include="Microsoft.Extensions.Hosting"/>
        <Using Include="Microsoft.Extensions.Logging"/>
        <!-- Every endpoint, service and seeder here takes a plain DbContext (the host aliases it to
             AppDbContext in DI), so Microsoft.EntityFrameworkCore is named by almost every file in
             the project. Global rather than 50-odd identical using lines. -->
        <Using Include="Microsoft.EntityFrameworkCore"/>
    </ItemGroup>

    <!-- Core + the framework, and nothing else. In particular there is NO reference to
         AdhdTimeOrganizer.TodoLists, even though PlannerTask carries a TodolistItemId FK to
         TodoListItem — see the notes below and AppDbContext.ConfigureCrossSliceRelationships. -->
    <ItemGroup>
        <ProjectReference Include="..\AdhdTimeOrganizer.Core\AdhdTimeOrganizer.Core.csproj"/>
        <ProjectReference Include="..\framework\Sydowwe.Framework\Sydowwe.Framework.csproj"/>
        <ProjectReference Include="..\framework\Sydowwe.Framework.Contracts\Sydowwe.Framework.Contracts.csproj"/>
    </ItemGroup>

</Project>
