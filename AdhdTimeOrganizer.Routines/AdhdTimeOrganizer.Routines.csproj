<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>14</LangVersion>
        <RootNamespace>AdhdTimeOrganizer.Routines</RootNamespace>
    </PropertyGroup>

    <!-- Same shape as AdhdTimeOrganizer.Core / .TodoLists: a plain library (Microsoft.NET.Sdk) that holds
         endpoints, so it needs the ASP.NET Core surface, and the Web SDK's implicit usings are not
         in scope here and are re-declared below. -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.AspNetCore.Builder"/>
        <Using Include="Microsoft.AspNetCore.Http"/>
        <Using Include="Microsoft.Extensions.Configuration"/>
        <Using Include="Microsoft.Extensions.DependencyInjection"/>
        <Using Include="Microsoft.Extensions.Hosting"/>
        <Using Include="Microsoft.Extensions.Logging"/>
        <!-- Every endpoint, job and seeder here takes a plain DbContext (the host aliases it to
             AppDbContext in DI), so Microsoft.EntityFrameworkCore is named by almost every file in
             the project. Global rather than 40-odd identical using lines. -->
        <Using Include="Microsoft.EntityFrameworkCore"/>
    </ItemGroup>

    <!-- No Quartz here, deliberately. The two scheduled jobs are keyed IScheduledJobHandler
         implementations (RoutineTodoListResetJobHandler, RoutinePeriodNudgeJobHandler) whose schedules
         RoutinesScheduledJobsRegistrar pushes through Sydowwe.Framework.Contracts' IScheduler.
         Sydowwe.Scheduler is the only project in the solution that references Quartz — don't add the
         package back to write an IJob. -->

    <!-- Deliberately no reference to AdhdTimeOrganizer (the host), and only Core + TodoLists among the
         slices: Routines references TodoLists for the shared to-do bases (BaseTodoListItem,
         TodoListStep, BaseTodoListConfigure, TodoListExtensions, the toggle/step/reorder endpoint
         bases) and TodoListSettings, but nothing points back. -->
    <ItemGroup>
        <ProjectReference Include="..\AdhdTimeOrganizer.Core\AdhdTimeOrganizer.Core.csproj"/>
        <ProjectReference Include="..\AdhdTimeOrganizer.TodoLists\AdhdTimeOrganizer.TodoLists.csproj"/>
        <ProjectReference Include="..\framework\Sydowwe.Framework\Sydowwe.Framework.csproj"/>
        <ProjectReference Include="..\framework\Sydowwe.Framework.Contracts\Sydowwe.Framework.Contracts.csproj"/>
    </ItemGroup>

</Project>
