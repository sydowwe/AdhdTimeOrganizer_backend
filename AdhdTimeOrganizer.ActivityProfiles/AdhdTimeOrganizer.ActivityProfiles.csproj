<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>14</LangVersion>
        <RootNamespace>AdhdTimeOrganizer.ActivityProfiles</RootNamespace>
    </PropertyGroup>

    <!-- Same shape as AdhdTimeOrganizer.Core / .TodoLists / .History / .Planning / .Tracking: a plain
         (Microsoft.NET.Sdk) library that holds endpoints, so it needs the ASP.NET Core surface, and the
         Web SDK's implicit usings are not in scope here and are re-declared below. -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.AspNetCore.Builder"/>
        <Using Include="Microsoft.AspNetCore.Http"/>
        <Using Include="Microsoft.Extensions.Configuration"/>
        <Using Include="Microsoft.Extensions.DependencyInjection"/>
        <Using Include="Microsoft.Extensions.Hosting"/>
        <Using Include="Microsoft.Extensions.Logging"/>
    </ItemGroup>

    <!-- Core only, and no outbound slice edge — this slice needed none to begin with. Nothing outside
         AdhdTimeOrganizer.Core referenced the three Activity*Profile entities, the four activity
         lookups or MemoryAnchor before the extraction: not History, not Planning, not Tracking, not
         TodoLists, not Routines. The only inbound edges were three navigation properties on Activity
         and one collection on User, and those were deleted rather than inverted (see
         Activity.cs / User.cs, and docs/summary.md for why no seam was needed).

         Do not add a ProjectReference to any feature slice here. If a slice ever needs to filter on
         profile rows, use Core's IActivityMembershipSource seam the way History does — the entities
         in this project are pure leaves and should stay that way. -->
    <ItemGroup>
        <ProjectReference Include="..\AdhdTimeOrganizer.Core\AdhdTimeOrganizer.Core.csproj"/>
        <ProjectReference Include="..\framework\Sydowwe.Framework\Sydowwe.Framework.csproj"/>
        <ProjectReference Include="..\framework\Sydowwe.Framework.Contracts\Sydowwe.Framework.Contracts.csproj"/>
    </ItemGroup>

</Project>
