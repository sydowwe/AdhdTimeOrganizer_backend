<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>14</LangVersion>
        <RootNamespace>AdhdTimeOrganizer.Core</RootNamespace>
    </PropertyGroup>

    <!-- Core holds endpoints, so it needs the ASP.NET Core surface. It is a plain library
         (Microsoft.NET.Sdk), not Microsoft.NET.Sdk.Web like the host — so the Web SDK's implicit
         usings are not in scope here and the ones the moved files rely on are re-declared below.
         Without them ~56 files fail on ILogger<> / IServiceScopeFactory / IHttpContextAccessor alone. -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.AspNetCore.Builder"/>
        <Using Include="Microsoft.AspNetCore.Http"/>
        <Using Include="Microsoft.Extensions.Configuration"/>
        <Using Include="Microsoft.Extensions.DependencyInjection"/>
        <Using Include="Microsoft.Extensions.Hosting"/>
        <Using Include="Microsoft.Extensions.Logging"/>
    </ItemGroup>

    <!-- Deliberately no reference to AdhdTimeOrganizer (the host). Core holds the hub entities and the
         shared primitives every vertical slice depends on; AppDbContext, Program.cs, the migrations and
         the DI wiring all stay host-side. A reference back would make the split circular on day one.
         That is why nothing here names AppDbContext - endpoints and services take a plain DbContext,
         which ModuleServiceExtensions aliases to AppDbContext. -->
    <ItemGroup>
        <ProjectReference Include="..\framework\Sydowwe.Framework\Sydowwe.Framework.csproj"/>
        <ProjectReference Include="..\framework\Sydowwe.Framework.Contracts\Sydowwe.Framework.Contracts.csproj"/>
    </ItemGroup>

</Project>
